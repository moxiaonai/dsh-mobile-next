{
  "name": "dsh-mobile-next",
  "version": "0.2.0",
  "description": "DSH 移动端接入插件：局域网 HTTPS + iroh 加密远程通道 + 独立设备配对",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "locale/*.json",
    "assets/icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs/*.jpg",
    "docs/remote-access.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "listedByDefault": false
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "build": "rm -rf lib && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "node scripts/verify-patch.mjs && node scripts/verify-client.mjs && node scripts/verify-package.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "node-forge": "^1.4.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.9.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mobile"
  ],
  "license": "MIT",
  "author": "wuwenjing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moxiaonai/dsh-mobile-next.git",
    "directory": "dsh-mobile-next"
  },
  "homepage": "https://github.com/moxiaonai/dsh-mobile-next/tree/main/dsh-mobile-next#readme",
  "bugs": {
    "url": "https://github.com/moxiaonai/dsh-mobile-next/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
